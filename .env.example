# Docker Compose: public URL used for share links and Open Graph tags,
# and the host port (portman get plink/frontend).
PUBLIC_URL=https://stellar-hackathon-grand-pera.osmn.cc
PLINK_PORT=10013
# Optional demo faucet: testnet secret of an account holding USDC (fund it with
# `just fund plink-deployer 200`). Leave empty to disable.
DEMO_TREASURY_SECRET=
